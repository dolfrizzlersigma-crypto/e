; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can also be edited from code.

config_version=5

[application]

config/name="EXIT 13: Night Auditor"
config/description="A first-person horror-management game set at a lonely highway service plaza."
config/version="0.1.0"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.2", "Forward Plus")
config/icon="res://assets/textures/ui/icon.svg"

[autoload]

GameManager="*res://scripts/autoload/game_manager.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
EventDirector="*res://scripts/autoload/event_director.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
DialogueManager="*res://scripts/autoload/dialogue_manager.gd"
WeatherManager="*res://scripts/autoload/weather_manager.gd"
ObjectiveManager="*res://scripts/autoload/objective_manager.gd"
UpgradeManager="*res://scripts/autoload/upgrade_manager.gd"
SettingsManager="*res://scripts/autoload/settings_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

