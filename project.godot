; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="EXIT 13: NIGHT AUDITOR"
config/description="A first-person horror-management game about working the graveyard shift at a haunted highway service plaza"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameManager="*res://scripts/autoloads/game_manager.gd"
EventBus="*res://scripts/autoloads/event_bus.gd"
SaveSystem="*res://scripts/autoloads/save_system.gd"
AudioManager="*res://scripts/autoloads/audio_manager.gd"
Settings="*res://scripts/autoloads/settings.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="canvas_items"

